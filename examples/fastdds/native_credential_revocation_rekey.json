{
  "schema_version": 1,
  "id": "fastdds-native-credential-revocation-rekey",
  "title": "Fast DDS certificate expiry, remote revocation, and participant rekey",
  "implementation": {"name": "fastdds", "version": "3.6.2"},
  "domain_id": 228,
  "participants": {
    "reader": {
      "role": "authorized_reader",
      "identity": {"subject": "/CN=revocation-reader/O=DDSleuth"},
      "permissions": {"subscribe": ["RevocationTopic"]}
    },
    "writer": {
      "role": "expiring_writer",
      "identity": {
        "subject": "/CN=expiring-writer/O=DDSleuth",
        "expires_after_seconds": 12
      },
      "permissions": {"publish": ["RevocationTopic"]}
    }
  },
  "policy": {"grant_order": ["reader", "writer"]},
  "governance": {
    "allow_unauthenticated_participants": false,
    "enable_join_access_control": true,
    "discovery_protection": "encrypt",
    "liveliness_protection": "encrypt",
    "rtps_protection": "encrypt"
  },
  "topics": {
    "RevocationTopic": {
      "enable_discovery_protection": true,
      "enable_liveliness_protection": true,
      "enable_read_access_control": true,
      "enable_write_access_control": true,
      "metadata_protection": "encrypt_with_origin_authentication",
      "data_protection": "encrypt"
    }
  },
  "assertions": [
    {"id": "INV-OBSERVER-01", "oracle": "observer_health", "parameters": {}},
    {"id": "INV-POLICY-01", "oracle": "policy_authorization_consistency", "parameters": {}},
    {"id": "INV-ROUTE-01", "oracle": "crypto_token_transport_consistency", "parameters": {"require_all_generated": true}}
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 45,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader",
        "command": ["${DDSLEUTH_FASTDDS_NATIVE_PROBE}", "reader", "scripted-reader", "228", "RevocationTopic", "30000", "allow"],
        "environment": {"ASAN_OPTIONS": "detect_leaks=0", "DDSLEUTH_FASTDDS_OBSERVER": "1"},
        "actions": [
          {"id": "create-reader", "at_ms": 0, "operation": "endpoint.create"},
          {"id": "receive-before-expiry", "at_ms": 0, "operation": "sample.wait", "arguments": ["1"]},
          {"id": "observe-remote-revocation", "at_ms": 0, "operation": "credential.wait_revoked", "arguments": ["1"]}
        ]
      },
      {
        "actor": "writer",
        "command": ["${DDSLEUTH_FASTDDS_NATIVE_PROBE}", "writer", "scripted-writer", "228", "RevocationTopic", "30000", "allow"],
        "environment": {"ASAN_OPTIONS": "detect_leaks=0", "DDSLEUTH_FASTDDS_OBSERVER": "1"},
        "start_after": [{"actor": "reader", "kind": "endpoint.created", "outcome": "created", "attributes": {"endpoint": "reader", "topic": "RevocationTopic"}}],
        "actions": [
          {"id": "create-writer", "at_ms": 0, "operation": "endpoint.create"},
          {"id": "match-reader", "at_ms": 0, "operation": "endpoint.wait_match"},
          {"id": "write-before-expiry", "at_ms": 0, "operation": "sample.write", "arguments": ["before credential revocation"]},
          {"id": "observe-local-revocation", "at_ms": 0, "operation": "credential.wait_revoked", "arguments": ["1"]}
        ]
      }
    ]
  }
}
