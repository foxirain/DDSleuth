{
  "schema_version": 1,
  "id": "fastdds-native-transport-replay",
  "title": "Fast DDS exact loopback UDP replay trajectory",
  "implementation": {"name": "fastdds", "version": "3.6.2"},
  "domain_id": 227,
  "participants": {
    "reader": {"role": "authorized_reader", "identity": {"subject": "/CN=replay-reader/O=DDSleuth"}, "permissions": {"subscribe": ["ReplayTopic"]}},
    "writer": {"role": "authorized_writer", "identity": {"subject": "/CN=replay-writer/O=DDSleuth"}, "permissions": {"publish": ["ReplayTopic"]}}
  },
  "policy": {"grant_order": ["reader", "writer"]},
  "governance": {"allow_unauthenticated_participants": false, "enable_join_access_control": true, "discovery_protection": "encrypt", "liveliness_protection": "encrypt", "rtps_protection": "encrypt"},
  "topics": {"ReplayTopic": {"enable_discovery_protection": true, "enable_liveliness_protection": true, "enable_read_access_control": true, "enable_write_access_control": true, "metadata_protection": "encrypt_with_origin_authentication", "data_protection": "encrypt"}},
  "assertions": [
    {"id": "INV-OBSERVER-01", "oracle": "observer_health", "parameters": {}},
    {"id": "INV-POLICY-01", "oracle": "policy_authorization_consistency", "parameters": {}}
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 45,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader",
        "command": ["${DDSLEUTH_FASTDDS_NATIVE_PROBE}", "reader", "reader", "227", "ReplayTopic", "30000", "allow"],
        "environment": {"ASAN_OPTIONS": "detect_leaks=0", "DDSLEUTH_FASTDDS_OBSERVER": "1"}
      },
      {
        "actor": "writer",
        "command": ["${DDSLEUTH_FASTDDS_NATIVE_PROBE}", "writer", "scripted-writer", "227", "ReplayTopic", "30000", "allow"],
        "environment": {"ASAN_OPTIONS": "detect_leaks=0", "DDSLEUTH_FASTDDS_OBSERVER": "1"},
        "start_after": [{"actor": "reader", "kind": "probe.ready", "outcome": "ready", "attributes": {"endpoint": "reader", "topic": "ReplayTopic"}}],
        "actions": [
          {"id": "create", "at_ms": 0, "operation": "endpoint.create"},
          {"id": "match", "at_ms": 0, "operation": "endpoint.wait_match"},
          {"id": "duplicate", "at_ms": 100, "operation": "transport.duplicate_next", "arguments": ["1"]},
          {"id": "write", "at_ms": 150, "operation": "sample.write", "arguments": ["transport replay control"]},
          {"id": "replay", "at_ms": 250, "operation": "transport.replay_last", "arguments": ["1"]}
        ]
      }
    ]
  }
}
