{
  "schema_version": 1,
  "id": "fastdds-native-multi-recipient-distribution",
  "title": "Fast DDS receiver-specific key distribution across two authorized readers",
  "implementation": {
    "name": "fastdds",
    "version": "3.6.2"
  },
  "domain_id": 226,
  "participants": {
    "reader_a": {
      "role": "authorized_reader",
      "identity": {
        "subject": "/CN=reader-a/O=DDSleuth"
      },
      "permissions": {
        "subscribe": ["MultiRecipientTopic"]
      }
    },
    "reader_b": {
      "role": "authorized_reader",
      "identity": {
        "subject": "/CN=reader-b/O=DDSleuth"
      },
      "permissions": {
        "subscribe": ["MultiRecipientTopic"]
      }
    },
    "writer": {
      "role": "authorized_writer",
      "identity": {
        "subject": "/CN=multi-writer/O=DDSleuth"
      },
      "permissions": {
        "publish": ["MultiRecipientTopic"]
      }
    }
  },
  "policy": {
    "grant_order": ["reader_a", "reader_b", "writer"]
  },
  "governance": {
    "allow_unauthenticated_participants": false,
    "enable_join_access_control": true,
    "discovery_protection": "encrypt",
    "liveliness_protection": "encrypt",
    "rtps_protection": "encrypt"
  },
  "topics": {
    "MultiRecipientTopic": {
      "enable_discovery_protection": true,
      "enable_liveliness_protection": true,
      "enable_read_access_control": true,
      "enable_write_access_control": true,
      "metadata_protection": "encrypt_with_origin_authentication",
      "data_protection": "encrypt"
    }
  },
  "assertions": [
    {
      "id": "INV-OBSERVER-HEALTH-01",
      "oracle": "observer_health",
      "parameters": {}
    },
    {
      "id": "INV-POLICY-01",
      "oracle": "policy_authorization_consistency",
      "parameters": {}
    },
    {
      "id": "INV-RECIPIENT-01",
      "oracle": "crypto_token_recipient_binding",
      "parameters": {}
    },
    {
      "id": "INV-TRANSPORT-01",
      "oracle": "crypto_token_transport_consistency",
      "parameters": {
        "require_all_generated": true
      }
    },
    {
      "id": "INV-USER-KEY-SCOPE-01",
      "oracle": "key_scope_separation",
      "parameters": {
        "scope_attribute": "destination_participant_guid",
        "observation_phase": "received",
        "endpoint_class": "user"
      }
    }
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 50,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader_a",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "reader_a",
          "reader",
          "226",
          "MultiRecipientTopic",
          "25000",
          "allow"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1"
        }
      },
      {
        "actor": "reader_b",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "reader_b",
          "reader",
          "226",
          "MultiRecipientTopic",
          "25000",
          "allow"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1"
        },
        "start_after": [
          {
            "actor": "reader_a",
            "kind": "probe.ready",
            "outcome": "ready",
            "attributes": {
              "endpoint": "reader",
              "topic": "MultiRecipientTopic"
            }
          }
        ]
      },
      {
        "actor": "writer",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "writer",
          "writer",
          "226",
          "MultiRecipientTopic",
          "25000",
          "allow",
          "multi-recipient secure delivery"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1",
          "DDSLEUTH_EXPECTED_MATCHES": "2"
        },
        "start_after": [
          {
            "actor": "reader_a",
            "kind": "probe.ready",
            "outcome": "ready",
            "attributes": {
              "endpoint": "reader",
              "topic": "MultiRecipientTopic"
            }
          },
          {
            "actor": "reader_b",
            "kind": "probe.ready",
            "outcome": "ready",
            "attributes": {
              "endpoint": "reader",
              "topic": "MultiRecipientTopic"
            }
          }
        ]
      }
    ]
  }
}
