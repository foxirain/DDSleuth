{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ddsleuth:schema:candidates:v1",
  "title": "DDSleuth runtime discovery candidates",
  "type": "object",
  "required": [
    "schema_version",
    "scenario_id",
    "scenario_digest",
    "run_id",
    "candidate_count",
    "candidates"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "scenario_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "run_id": { "type": "string", "minLength": 1 },
    "candidate_count": { "type": "integer", "minimum": 0 },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id", "fingerprint", "family", "title", "risk_tier",
          "score", "confidence", "actors", "resources", "evidence_events",
          "signals", "execution_complete", "details"
        ],
        "properties": {
          "candidate_id": { "type": "string", "minLength": 1 },
          "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "family": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "risk_tier": { "enum": ["critical_lead", "high_lead", "investigate"] },
          "score": { "type": "integer", "minimum": 0, "maximum": 100 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "actors": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "resources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "evidence_events": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "uniqueItems": true },
          "signals": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "execution_complete": { "type": "boolean" },
          "details": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
