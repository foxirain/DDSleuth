{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ddsleuth:schema:scenario:v1",
  "title": "DDSleuth scenario",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "title",
    "implementation",
    "domain_id",
    "participants",
    "assertions"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "implementation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      },
      "additionalProperties": false
    },
    "domain_id": { "type": "integer", "minimum": 0, "maximum": 232 },
    "participants": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": ["role"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "permissions": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "identity": {
            "type": "object",
            "required": ["subject"],
            "properties": {
              "subject": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "grant_order": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "allow_unauthenticated_participants": { "type": "boolean" },
        "enable_join_access_control": { "type": "boolean" },
        "discovery_protection": { "type": "string" },
        "liveliness_protection": { "type": "string" },
        "rtps_protection": { "type": "string" }
      },
      "additionalProperties": false
    },
    "topics": {
      "type": "object",
      "additionalProperties": { "type": "object" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "oracle"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "oracle": { "type": "string", "minLength": 1 },
          "parameters": { "type": "object" }
        },
        "additionalProperties": false
      }
    },
    "execution": {
      "type": "object",
      "required": ["network", "log_format", "roles"],
      "properties": {
        "network": { "type": "string" },
        "timeout_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "log_format": { "type": "string" },
        "roles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["actor", "command"],
            "properties": {
              "actor": { "type": "string" },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string" }
              },
              "environment": {
                "type": "object",
                "additionalProperties": { "type": "string" }
              },
              "start_offset_ms": {
                "type": "number",
                "minimum": 0
              },
              "actions": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["id", "at_ms", "operation"],
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "at_ms": { "type": "number", "minimum": 0 },
                    "operation": { "type": "string", "minLength": 1 },
                    "arguments": {
                      "type": "array",
                      "items": { "type": "string" }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "start_after": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["actor", "kind"],
                  "properties": {
                    "actor": { "type": "string", "minLength": 1 },
                    "kind": { "type": "string", "minLength": 1 },
                    "outcome": { "type": "string" },
                    "attributes": { "type": "object" }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
