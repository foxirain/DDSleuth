{
  "schema_version": 1,
  "id": "fastdds-native-participant-reconnect",
  "title": "Fast DDS secure participant disconnect and reconnect trajectory",
  "implementation": {"name": "fastdds", "version": "3.6.2"},
  "domain_id": 229,
  "participants": {
    "reader": {
      "role": "authorized_reader",
      "identity": {"subject": "/CN=reconnect-reader/O=DDSleuth"},
      "permissions": {"subscribe": ["ReconnectTopic"]}
    },
    "writer": {
      "role": "authorized_writer",
      "identity": {"subject": "/CN=reconnect-writer/O=DDSleuth"},
      "permissions": {"publish": ["ReconnectTopic"]}
    }
  },
  "policy": {"grant_order": ["reader", "writer"]},
  "governance": {
    "allow_unauthenticated_participants": false,
    "enable_join_access_control": true,
    "discovery_protection": "encrypt",
    "liveliness_protection": "encrypt",
    "rtps_protection": "encrypt"
  },
  "topics": {
    "ReconnectTopic": {
      "enable_discovery_protection": true,
      "enable_liveliness_protection": true,
      "enable_read_access_control": true,
      "enable_write_access_control": true,
      "metadata_protection": "encrypt_with_origin_authentication",
      "data_protection": "encrypt"
    }
  },
  "assertions": [
    {"id": "INV-OBSERVER-01", "oracle": "observer_health", "parameters": {}},
    {"id": "INV-POLICY-01", "oracle": "policy_authorization_consistency", "parameters": {}},
    {"id": "INV-ROUTE-01", "oracle": "crypto_token_transport_consistency", "parameters": {"require_all_generated": true}}
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 60,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader",
        "command": ["${DDSLEUTH_FASTDDS_NATIVE_PROBE}", "reader", "reader", "229", "ReconnectTopic", "30000", "allow"],
        "environment": {"ASAN_OPTIONS": "detect_leaks=0", "DDSLEUTH_FASTDDS_OBSERVER": "1", "DDSLEUTH_EXPECTED_SAMPLES": "2"}
      },
      {
        "actor": "writer",
        "command": ["${DDSLEUTH_FASTDDS_NATIVE_PROBE}", "writer", "scripted-writer", "229", "ReconnectTopic", "30000", "allow"],
        "environment": {"ASAN_OPTIONS": "detect_leaks=0", "DDSLEUTH_FASTDDS_OBSERVER": "1"},
        "start_after": [{"actor": "reader", "kind": "probe.ready", "outcome": "ready", "attributes": {"endpoint": "reader", "topic": "ReconnectTopic"}}],
        "actions": [
          {"id": "create-1", "at_ms": 0, "operation": "endpoint.create"},
          {"id": "match-1", "at_ms": 0, "operation": "endpoint.wait_match"},
          {"id": "write-1", "at_ms": 0, "operation": "sample.write", "arguments": ["before participant reconnect"]},
          {"id": "destroy-1", "at_ms": 25, "operation": "endpoint.destroy"},
          {"id": "disconnect", "at_ms": 50, "operation": "participant.disconnect"},
          {"id": "reconnect", "at_ms": 100, "operation": "participant.reconnect"},
          {"id": "create-2", "at_ms": 100, "operation": "endpoint.create"},
          {"id": "match-2", "at_ms": 100, "operation": "endpoint.wait_match"},
          {"id": "write-2", "at_ms": 100, "operation": "sample.write", "arguments": ["after participant reconnect"]}
        ]
      }
    ]
  }
}
