{
  "schema_version": 1,
  "id": "fastdds-native-endpoint-recreation",
  "title": "Fast DDS user-endpoint key lifecycle across writer recreation",
  "implementation": {
    "name": "fastdds",
    "version": "3.6.2"
  },
  "domain_id": 227,
  "participants": {
    "reader": {
      "role": "authorized_reader",
      "identity": {
        "subject": "/CN=lifecycle-reader/O=DDSleuth"
      },
      "permissions": {
        "subscribe": ["LifecycleTopic"]
      }
    },
    "writer": {
      "role": "authorized_writer",
      "identity": {
        "subject": "/CN=lifecycle-writer/O=DDSleuth"
      },
      "permissions": {
        "publish": ["LifecycleTopic"]
      }
    }
  },
  "policy": {
    "grant_order": ["reader", "writer"]
  },
  "governance": {
    "allow_unauthenticated_participants": false,
    "enable_join_access_control": true,
    "discovery_protection": "encrypt",
    "liveliness_protection": "encrypt",
    "rtps_protection": "encrypt"
  },
  "topics": {
    "LifecycleTopic": {
      "enable_discovery_protection": true,
      "enable_liveliness_protection": true,
      "enable_read_access_control": true,
      "enable_write_access_control": true,
      "metadata_protection": "encrypt_with_origin_authentication",
      "data_protection": "encrypt"
    }
  },
  "assertions": [
    {
      "id": "INV-OBSERVER-HEALTH-01",
      "oracle": "observer_health",
      "parameters": {}
    },
    {
      "id": "INV-POLICY-01",
      "oracle": "policy_authorization_consistency",
      "parameters": {}
    },
    {
      "id": "INV-RECIPIENT-01",
      "oracle": "crypto_token_recipient_binding",
      "parameters": {}
    },
    {
      "id": "INV-TRANSPORT-01",
      "oracle": "crypto_token_transport_consistency",
      "parameters": {
        "require_all_generated": true
      }
    },
    {
      "id": "INV-ENDPOINT-KEY-LIFECYCLE-01",
      "oracle": "endpoint_key_lifecycle",
      "parameters": {
        "actor": "writer",
        "token_class": "datawriter",
        "endpoint_class": "user",
        "observation_phase": "generated"
      }
    }
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 60,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "reader",
          "reader",
          "227",
          "LifecycleTopic",
          "30000",
          "allow"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1",
          "DDSLEUTH_EXPECTED_SAMPLES": "2"
        }
      },
      {
        "actor": "writer",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "writer",
          "recreate-writer",
          "227",
          "LifecycleTopic",
          "30000",
          "allow",
          "endpoint lifecycle sample"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1"
        },
        "start_after": [
          {
            "actor": "reader",
            "kind": "probe.ready",
            "outcome": "ready",
            "attributes": {
              "endpoint": "reader",
              "topic": "LifecycleTopic"
            }
          }
        ]
      }
    ]
  }
}
