{
  "schema_version": 1,
  "id": "fastdds-native-late-denied-join",
  "title": "Fast DDS denied late joiner after protected writer association",
  "implementation": {
    "name": "fastdds",
    "version": "3.6.2"
  },
  "domain_id": 228,
  "participants": {
    "reader": {
      "role": "authorized_reader",
      "identity": {
        "subject": "/CN=late-join-reader/O=DDSleuth"
      },
      "permissions": {
        "subscribe": ["LateJoinTopic"]
      }
    },
    "writer": {
      "role": "authorized_writer",
      "identity": {
        "subject": "/CN=late-join-writer/O=DDSleuth"
      },
      "permissions": {
        "publish": ["LateJoinTopic"]
      }
    },
    "late_denied": {
      "role": "authenticated_denied_reader",
      "identity": {
        "subject": "/CN=late-denied/O=DDSleuth"
      },
      "permissions": {}
    }
  },
  "policy": {
    "grant_order": ["reader", "writer", "late_denied"]
  },
  "governance": {
    "allow_unauthenticated_participants": false,
    "enable_join_access_control": true,
    "discovery_protection": "encrypt",
    "liveliness_protection": "encrypt",
    "rtps_protection": "encrypt"
  },
  "topics": {
    "LateJoinTopic": {
      "enable_discovery_protection": true,
      "enable_liveliness_protection": true,
      "enable_read_access_control": true,
      "enable_write_access_control": true,
      "metadata_protection": "encrypt_with_origin_authentication",
      "data_protection": "encrypt"
    }
  },
  "assertions": [
    {
      "id": "INV-OBSERVER-HEALTH-01",
      "oracle": "observer_health",
      "parameters": {}
    },
    {
      "id": "INV-POLICY-01",
      "oracle": "policy_authorization_consistency",
      "parameters": {}
    },
    {
      "id": "INV-LATE-DENIED-KEY-01",
      "oracle": "unauthorized_key_disclosure",
      "parameters": {
        "actor": "late_denied"
      }
    },
    {
      "id": "INV-RECIPIENT-01",
      "oracle": "crypto_token_recipient_binding",
      "parameters": {}
    },
    {
      "id": "INV-TRANSPORT-01",
      "oracle": "crypto_token_transport_consistency",
      "parameters": {
        "require_all_generated": true
      }
    },
    {
      "id": "INV-USER-KEY-SCOPE-01",
      "oracle": "key_scope_separation",
      "parameters": {
        "scope_attribute": "destination_participant_guid",
        "observation_phase": "received",
        "endpoint_class": "user"
      }
    }
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 45,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "reader",
          "reader",
          "228",
          "LateJoinTopic",
          "20000",
          "allow"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1"
        }
      },
      {
        "actor": "writer",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "writer",
          "writer",
          "228",
          "LateJoinTopic",
          "20000",
          "allow",
          "protected traffic before denied late join"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1",
          "DDSLEUTH_HOLD_AFTER_WRITE_MS": "8000"
        },
        "start_after": [
          {
            "actor": "reader",
            "kind": "probe.ready",
            "outcome": "ready",
            "attributes": {
              "endpoint": "reader",
              "topic": "LateJoinTopic"
            }
          }
        ]
      },
      {
        "actor": "late_denied",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "late_denied",
          "observe-denied-reader",
          "228",
          "LateJoinTopic",
          "5000",
          "deny"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1"
        },
        "start_after": [
          {
            "actor": "writer",
            "kind": "application.sample_written",
            "outcome": "succeeded",
            "attributes": {
              "sample_index": 1
            }
          }
        ]
      }
    ]
  }
}
