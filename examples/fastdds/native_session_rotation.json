{
  "schema_version": 1,
  "id": "fastdds-native-session-rotation",
  "title": "Fast DDS protected delivery across repeated session-key rotation",
  "implementation": {
    "name": "fastdds",
    "version": "3.6.2"
  },
  "domain_id": 229,
  "participants": {
    "reader": {
      "role": "authorized_reader",
      "identity": {
        "subject": "/CN=rotation-reader/O=DDSleuth"
      },
      "permissions": {
        "subscribe": ["RotationTopic"]
      }
    },
    "writer": {
      "role": "authorized_writer",
      "identity": {
        "subject": "/CN=rotation-writer/O=DDSleuth"
      },
      "permissions": {
        "publish": ["RotationTopic"]
      }
    }
  },
  "policy": {
    "grant_order": ["reader", "writer"]
  },
  "governance": {
    "allow_unauthenticated_participants": false,
    "enable_join_access_control": true,
    "discovery_protection": "encrypt",
    "liveliness_protection": "encrypt",
    "rtps_protection": "encrypt"
  },
  "topics": {
    "RotationTopic": {
      "enable_discovery_protection": true,
      "enable_liveliness_protection": true,
      "enable_read_access_control": true,
      "enable_write_access_control": true,
      "metadata_protection": "encrypt_with_origin_authentication",
      "data_protection": "encrypt"
    }
  },
  "assertions": [
    {
      "id": "INV-OBSERVER-HEALTH-01",
      "oracle": "observer_health",
      "parameters": {}
    },
    {
      "id": "INV-POLICY-01",
      "oracle": "policy_authorization_consistency",
      "parameters": {}
    },
    {
      "id": "INV-RECIPIENT-01",
      "oracle": "crypto_token_recipient_binding",
      "parameters": {}
    },
    {
      "id": "INV-TRANSPORT-01",
      "oracle": "crypto_token_transport_consistency",
      "parameters": {
        "require_all_generated": true
      }
    },
    {
      "id": "INV-SESSION-ROTATION-01",
      "oracle": "session_rotation_delivery",
      "parameters": {
        "writer": "writer",
        "reader": "reader",
        "context": "serialized_payload",
        "minimum_rotations": 3,
        "max_blocks_per_session": 2
      }
    }
  ],
  "execution": {
    "network": "loopback",
    "timeout_seconds": 45,
    "log_format": "ddssec-jsonl",
    "roles": [
      {
        "actor": "reader",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "reader",
          "reader",
          "229",
          "RotationTopic",
          "25000",
          "allow"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1",
          "DDSLEUTH_EXPECTED_SAMPLES": "6"
        }
      },
      {
        "actor": "writer",
        "command": [
          "${DDSLEUTH_FASTDDS_NATIVE_PROBE}",
          "writer",
          "writer",
          "229",
          "RotationTopic",
          "25000",
          "allow",
          "session rotation sample"
        ],
        "environment": {
          "ASAN_OPTIONS": "detect_leaks=0",
          "DDSLEUTH_FASTDDS_OBSERVER": "1",
          "DDSLEUTH_SAMPLE_COUNT": "6",
          "DDSLEUTH_MAX_BLOCKS_PER_SESSION": "2"
        },
        "start_after": [
          {
            "actor": "reader",
            "kind": "probe.ready",
            "outcome": "ready",
            "attributes": {
              "endpoint": "reader",
              "topic": "RotationTopic"
            }
          }
        ]
      }
    ]
  }
}
